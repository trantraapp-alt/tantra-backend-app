{
  "info": {
    "name": "Tantra - Address Book",
    "description": "Profile > Address: create/list/update/default/delete (max 10, one default). Run top-to-bottom. Uses the same test user (9000000002) as the category collections.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "addressId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Signup User (ignore if exists)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ravi\",\n  \"lastName\": \"Kumar\",\n  \"mobileNumber\": \"9000000002\",\n  \"password\": \"Seller@123\",\n  \"appUsageRole\": \"USER\",\n  \"preferredLanguage\": \"HI\"\n}"
            }
          }
        },
        {
          "name": "Signin User (captures sellerToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "signin"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"9000000002\",\n  \"password\": \"Seller@123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var r = pm.response.json();",
                  "var d = (r && r.data) ? r.data : r;",
                  "if (d && d.token != null) pm.collectionVariables.set('sellerToken', d.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Address Book",
      "item": [
        {
          "name": "Create Address (captures addressId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Farm\",\n  \"fullAddress\": \"Village Rampur, Near Water Tank\",\n  \"country\": \"IN\",\n  \"state\": \"MP\",\n  \"district\": \"Bhopal\",\n  \"city\": \"Bhopal\",\n  \"village\": \"Rampur\",\n  \"pinCode\": \"462001\",\n  \"latitude\": 23.25,\n  \"longitude\": 77.41,\n  \"mobileNumber\": \"9000000002\",\n  \"altMobileNumber\": \"9000000003\",\n  \"isDefault\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var r = pm.response.json();",
                  "var d = (r && r.data) ? r.data : r;",
                  "if (d && d.addressId != null) pm.collectionVariables.set('addressId', d.addressId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Second Address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Home\",\n  \"fullAddress\": \"House 12, Main Road\",\n  \"country\": \"IN\",\n  \"state\": \"MP\",\n  \"district\": \"Indore\",\n  \"city\": \"Indore\",\n  \"pinCode\": \"452001\",\n  \"mobileNumber\": \"9000000002\"\n}"
            }
          }
        },
        {
          "name": "Get All Addresses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses"
              ]
            }
          }
        },
        {
          "name": "Get Default Address",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses/default",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses",
                "default"
              ]
            }
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses",
                "{{addressId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Farm (updated)\",\n  \"fullAddress\": \"Village Rampur, Plot 7\",\n  \"country\": \"IN\",\n  \"state\": \"MP\",\n  \"district\": \"Bhopal\",\n  \"city\": \"Bhopal\",\n  \"village\": \"Rampur\",\n  \"pinCode\": \"462001\",\n  \"mobileNumber\": \"9000000002\",\n  \"isDefault\": true\n}"
            }
          }
        },
        {
          "name": "Set As Default",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}/default",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses",
                "{{addressId}}",
                "default"
              ]
            }
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "addresses",
                "{{addressId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}