{
  "info": {
    "name": "Tantra - Business Profile & Verification",
    "description": "Dealer creates a business profile -> admin verifies -> owner notified (every action returns + notifies the reason). Approve removes it from the PENDING queue and it shows in Approval History. REJECT = fixable (owner edits & resubmits -> PENDING). BLOCK = permanent (offensive content; owner cannot resubmit). Both auto-hide the profile from buyers. Seeds the profile-type dropdown too. Run top-to-bottom on a clean DB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "set_bp_type",
      "value": ""
    },
    {
      "key": "profileId",
      "value": ""
    }
  ],
