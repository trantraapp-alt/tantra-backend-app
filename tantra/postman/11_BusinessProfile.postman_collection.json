            "body": {
              "mode": "raw",
              "raw": "{\n  \"formType\": \"BUSINESS_PROFILE\",\n  \"contextKey\": \"business_profile\",\n  \"version\": 1,\n  \"isActive\": true,\n  \"title\": {\n    \"en\": \"Business Profile\",\n    \"hi\": \"व्यवसाय प्रोफ़ाइल\"\n  },\n  \"fields\": [\n    {\n      \"fieldKey\": \"profileType\",\n      \"type\": \"DROPDOWN\",\n      \"optionSetKey\": \"business_profile_type\",\n      \"required\": true,\n      \"common\": true,\n      \"sectionKey\": \"details\",\n      \"sectionTitle\": {\n        \"en\": \"Business Details\",\n        \"hi\": \"व्यवसाय विवरण\"\n      },\n      \"label\": {\n        \"en\": \"Profile Type\",\n        \"hi\": \"प्रोफ़ाइल प्रकार\"\n      },\n      \"displayOrder\": 10\n    },\n    {\n      \"fieldKey\": \"businessName\",\n      \"type\": \"TEXT\",\n      \"required\": true,\n      \"common\": true,\n      \"sectionKey\": \"details\",\n      \"label\": {\n        \"en\": \"Business Name\",\n        \"hi\": \"व्यवसाय का नाम\"\n      },\n      \"fieldLength\": 150,\n      \"validation\": {\n        \"maxLength\": 150\n      },\n      \"displayOrder\": 20\n    },\n    {\n      \"fieldKey\": \"ownerName\",\n      \"type\": \"TEXT\",\n      \"sectionKey\": \"details\",\n      \"label\": {\n        \"en\": \"Owner Name\",\n        \"hi\": \"मालिक का नाम\"\n      },\n      \"fieldLength\": 120,\n      \"validation\": {\n        \"maxLength\": 120\n      },\n      \"displayOrder\": 30\n    },\n    {\n      \"fieldKey\": \"description\",\n      \"type\": \"TEXTAREA\",\n      \"sectionKey\": \"details\",\n      \"label\": {\n        \"en\": \"Description\",\n        \"hi\": \"विवरण\"\n      },\n      \"validation\": {\n        \"maxLength\": 1000\n      },\n      \"displayOrder\": 40\n    },\n    {\n      \"fieldKey\": \"mobileNumber\",\n      \"type\": \"TEXT\",\n      \"sectionKey\": \"contact\",\n      \"sectionTitle\": {\n        \"en\": \"Contact\",\n        \"hi\": \"संपर्क\"\n      },\n      \"label\": {\n        \"en\": \"Mobile Number\",\n        \"hi\": \"मोबाइल नंबर\"\n      },\n      \"validation\": {\n        \"regex\": \"^[6-9][0-9]{9}$\"\n      },\n      \"displayOrder\": 50\n    },\n    {\n      \"fieldKey\": \"email\",\n      \"type\": \"TEXT\",\n      \"sectionKey\": \"contact\",\n      \"label\": {\n        \"en\": \"Email\",\n        \"hi\": \"ईमेल\"\n      },\n      \"displayOrder\": 60\n    },\n    {\n      \"fieldKey\": \"gstNumber\",\n      \"type\": \"TEXT\",\n      \"sectionKey\": \"contact\",\n      \"label\": {\n        \"en\": \"GST Number\",\n        \"hi\": \"जीएसटी नंबर\"\n      },\n      \"fieldLength\": 20,\n      \"displayOrder\": 70\n    },\n    {\n      \"fieldKey\": \"registrationNumber\",\n      \"type\": \"TEXT\",\n      \"sectionKey\": \"contact\",\n      \"label\": {\n        \"en\": \"Registration / License No.\",\n        \"hi\": \"पंजीकरण / लाइसेंस नं.\"\n      },\n      \"displayOrder\": 80\n    },\n    {\n      \"fieldKey\": \"photos\",\n      \"type\": \"IMAGE\",\n      \"multiple\": true,\n      \"sectionKey\": \"media\",\n      \"sectionTitle\": {\n        \"en\": \"Photos\",\n        \"hi\": \"तस्वीरें\"\n      },\n      \"label\": {\n        \"en\": \"Business Photos (max 3)\",\n        \"hi\": \"व्यवसाय तस्वीरें (अधिकतम 3)\"\n      },\n      \"help\": {\n        \"en\": \"Upload up to 3 photos of your shop / business (camera or gallery).\",\n        \"hi\": \"अपनी दुकान / व्यवसाय की अधिकतम 3 तस्वीरें अपलोड करें (कैमरा या गैलरी)।\"\n      },\n      \"validation\": {\n        \"min\": 0,\n        \"max\": 3,\n        \"acceptedTypes\": [\n          \"jpg\",\n          \"png\",\n          \"webp\"\n        ],\n        \"sources\": [\n          \"camera\",\n          \"gallery\"\n        ],\n        \"capture\": true\n      },\n      \"displayOrder\": 85\n    },\n    {\n      \"fieldKey\": \"isVisible\",\n      \"type\": \"BOOLEAN\",\n      \"common\": true,\n      \"sectionKey\": \"contact\",\n      \"label\": {\n        \"en\": \"Show my profile to buyers\",\n        \"hi\": \"मेरी प्रोफ़ाइल खरीदारों को दिखाएँ\"\n      },\n      \"displayOrder\": 90\n    },\n    {\n      \"fieldKey\": \"address\",\n      \"type\": \"ADDRESS\",\n      \"common\": true,\n      \"required\": true,\n      \"sectionKey\": \"address\",\n      \"sectionTitle\": {\n        \"en\": \"Address\",\n        \"hi\": \"पता\"\n      },\n      \"label\": {\n        \"en\": \"Address\",\n        \"hi\": \"पता\"\n      },\n      \"displayOrder\": 100\n    }\n  ]\n}"
