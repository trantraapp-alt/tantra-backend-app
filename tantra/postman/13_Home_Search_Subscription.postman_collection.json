{
  "info": {
    "_postman_id": "tantra-home-search-subscription",
    "name": "13_Home_Search_Subscription",
    "description": "Home Feed, Global Search, Nearby, Browse, Contact Reveal, Business Directory, Subscription Plans (duration-based, multilingual dual-mode). Subscriptions apply to both buyers and sellers via the unified UserSubscription flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:8080" },
    { "key": "token",      "value": "Bearer <your-jwt-token>" },
    { "key": "adminToken", "value": "Bearer <your-admin-jwt-token>" }
  ],
  "item": [

    {
      "name": "🏠 Home Feed",
      "item": [
        {
          "name": "GET Home Feed (All India)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/home?lang=en",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","home"],
              "query": [
                { "key": "lang", "value": "en" }
              ]
            }
          }
        },
        {
          "name": "GET Home Feed (District Filter — Hindi)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/home?district=Pune&lang=hi",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","home"],
              "query": [
                { "key": "district", "value": "Pune" },
                { "key": "lang",     "value": "hi" }
              ]
            }
          }
        }
      ]
    },

