    {
      "name": "4. Admin - Form Definition",
      "item": [
        {
          "name": "Create Crop Form",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/forms", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","forms"] },
            "body": { "mode": "raw", "raw": "{\n  \"categoryId\": {{cropCatId}},\n  \"listingType\": \"SELL\",\n  \"version\": 1,\n  \"isActive\": true,\n  \"title\": { \"en\": \"List Your Crop\", \"hi\": \"अपनी फसल सूचीबद्ध करें\" },\n  \"fields\": [\n    { \"fieldKey\": \"cropName\", \"type\": \"DROPDOWN\", \"optionSetKey\": \"crop_name\", \"allowOther\": true, \"required\": true, \"sectionKey\": \"details\", \"sectionTitle\": { \"en\": \"Crop Details\", \"hi\": \"फसल विवरण\" }, \"label\": { \"en\": \"Crop Name\", \"hi\": \"फसल का नाम\" }, \"displayOrder\": 10 },\n    { \"fieldKey\": \"cropNameOther\", \"type\": \"TEXT\", \"sectionKey\": \"details\", \"label\": { \"en\": \"Please Specify\", \"hi\": \"कृपया निर्दिष्ट करें\" }, \"visibleWhen\": { \"field\": \"cropName\", \"operator\": \"equals\", \"value\": \"__other__\" }, \"validation\": { \"maxLength\": 80 }, \"displayOrder\": 20 },\n    { \"fieldKey\": \"cropVariety\", \"type\": \"TEXT\", \"sectionKey\": \"details\", \"label\": { \"en\": \"Crop Variety\", \"hi\": \"फसल किस्म\" }, \"validation\": { \"maxLength\": 80 }, \"displayOrder\": 30 },\n    { \"fieldKey\": \"cropDescription\", \"type\": \"TEXTAREA\", \"sectionKey\": \"details\", \"label\": { \"en\": \"Crop Description\", \"hi\": \"फसल विवरण\" }, \"validation\": { \"maxLength\": 1000 }, \"displayOrder\": 40 },\n    { \"fieldKey\": \"qualityGrade\", \"type\": \"RADIO\", \"optionSetKey\": \"quality_grade\", \"required\": true, \"sectionKey\": \"details\", \"label\": { \"en\": \"Quality Grade\", \"hi\": \"गुणवत्ता ग्रेड\" }, \"displayOrder\": 50 },\n    { \"fieldKey\": \"harvestYear\", \"type\": \"DROPDOWN\", \"optionSetKey\": \"harvest_year\", \"required\": true, \"sectionKey\": \"details\", \"label\": { \"en\": \"Harvest Year\", \"hi\": \"फसल कटाई वर्ष\" }, \"displayOrder\": 60 },\n    { \"fieldKey\": \"harvestMonth\", \"type\": \"DROPDOWN\", \"optionSetKey\": \"month\", \"required\": true, \"sectionKey\": \"details\", \"label\": { \"en\": \"Harvest Month\", \"hi\": \"फसल कटाई माह\" }, \"displayOrder\": 70 },\n    { \"fieldKey\": \"cropUnit\", \"type\": \"DROPDOWN\", \"optionSetKey\": \"unit_of_measure\", \"sectionKey\": \"quantity\", \"sectionTitle\": { \"en\": \"Quantity & Unit\", \"hi\": \"मात्रा और इकाई\" }, \"label\": { \"en\": \"Crop Unit\", \"hi\": \"फसल इकाई\" }, \"displayOrder\": 80 },\n    { \"fieldKey\": \"qty\", \"type\": \"NUMBER\", \"required\": true, \"sectionKey\": \"quantity\", \"label\": { \"en\": \"Quantity\", \"hi\": \"मात्रा\" }, \"validation\": { \"min\": 1 }, \"displayOrder\": 90 },\n    { \"fieldKey\": \"qtyMeasurement\", \"type\": \"DROPDOWN\", \"optionSetKey\": \"unit_of_measure\", \"required\": true, \"sectionKey\": \"quantity\", \"label\": { \"en\": \"Unit\", \"hi\": \"इकाई\" }, \"displayOrder\": 100 },\n    { \"fieldKey\": \"pricePerQuintal\", \"type\": \"DECIMAL\", \"sectionKey\": \"pricing\", \"sectionTitle\": { \"en\": \"Pricing\", \"hi\": \"मूल्य निर्धारण\" }, \"label\": { \"en\": \"Price per Quintal\", \"hi\": \"प्रति क्विंटल मूल्य\" }, \"validation\": { \"min\": 0 }, \"displayOrder\": 110 },\n    { \"fieldKey\": \"pricePerKg\", \"type\": \"DECIMAL\", \"sectionKey\": \"pricing\", \"label\": { \"en\": \"Price per Kg\", \"hi\": \"प्रति किग्रा मूल्य\" }, \"validation\": { \"min\": 0 }, \"displayOrder\": 120 },\n    { \"fieldKey\": \"actualPrice\", \"type\": \"DECIMAL\", \"common\": true, \"required\": true, \"sectionKey\": \"pricing\", \"label\": { \"en\": \"Actual Price\", \"hi\": \"वास्तविक मूल्य\" }, \"validation\": { \"min\": 0 }, \"displayOrder\": 130 },\n    { \"fieldKey\": \"offeredPrice\", \"type\": \"DECIMAL\", \"common\": true, \"required\": true, \"sectionKey\": \"pricing\", \"label\": { \"en\": \"Offered Price\", \"hi\": \"प्रस्तावित मूल्य\" }, \"validation\": { \"min\": 0 }, \"displayOrder\": 140 },\n    { \"fieldKey\": \"discountPct\", \"type\": \"AUTO_CALC\", \"common\": true, \"sectionKey\": \"pricing\", \"label\": { \"en\": \"Discount %\", \"hi\": \"छूट %\" }, \"computed\": { \"formula\": \"(actualPrice - offeredPrice) / actualPrice * 100\", \"readOnly\": true }, \"displayOrder\": 150 },\n    { \"fieldKey\": \"isNegotiable\", \"type\": \"BOOLEAN\", \"common\": true, \"sectionKey\": \"pricing\", \"label\": { \"en\": \"Is Negotiable?\", \"hi\": \"क्या मोल-भाव योग्य है?\" }, \"displayOrder\": 160 },\n    { \"fieldKey\": \"images\", \"type\": \"IMAGE\", \"common\": true, \"multiple\": true, \"required\": true, \"sectionKey\": \"media\", \"sectionTitle\": { \"en\": \"Photos\", \"hi\": \"तस्वीरें\" }, \"label\": { \"en\": \"Crop Images\", \"hi\": \"फसल की तस्वीरें\" }, \"validation\": { \"min\": 1, \"max\": 10, \"acceptedTypes\": [\"jpg\", \"png\", \"webp\"] }, \"displayOrder\": 170 },\n    { \"fieldKey\": \"useDefaultAddress\", \"type\": \"BOOLEAN\", \"common\": true, \"sectionKey\": \"address\", \"sectionTitle\": { \"en\": \"Address\", \"hi\": \"पता\" }, \"label\": { \"en\": \"Use Default Address\", \"hi\": \"डिफ़ॉल्ट पते का उपयोग करें\" }, \"displayOrder\": 180 },\n    { \"fieldKey\": \"address\", \"type\": \"ADDRESS\", \"common\": true, \"required\": true, \"sectionKey\": \"address\", \"label\": { \"en\": \"Address\", \"hi\": \"पता\" }, \"visibleWhen\": { \"field\": \"useDefaultAddress\", \"operator\": \"equals\", \"value\": false }, \"displayOrder\": 190 }\n  ]\n}" }
          }
        }
