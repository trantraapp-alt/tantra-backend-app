{
  "info": {
    "name": "Tantra - Agriculture Crop (Dynamic Form)",
    "description": "End-to-end test for the dynamic form + dropdown + listing feature. Run the requests in order (or use the Collection Runner); tokens and IDs are captured automatically into collection variables.",
