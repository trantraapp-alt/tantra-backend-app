            "body": { "mode": "raw", "raw": "[\n  { \"itemKey\": \"2026\", \"label\": { \"en\": \"2026\", \"hi\": \"2026\" }, \"displayOrder\": 10 },\n  { \"itemKey\": \"2025\", \"label\": { \"en\": \"2025\", \"hi\": \"2025\" }, \"displayOrder\": 20 },\n  { \"itemKey\": \"2024\", \"label\": { \"en\": \"2024\", \"hi\": \"2024\" }, \"displayOrder\": 30 }\n]" }
