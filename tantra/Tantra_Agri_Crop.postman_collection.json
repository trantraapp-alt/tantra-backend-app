  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Signup Admin",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","signup"] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Admin\",\n  \"lastName\": \"Tantra\",\n  \"mobileNumber\": \"9000000001\",\n  \"password\": \"Admin@123\",\n  \"appUsageRole\": \"ADMIN\",\n  \"preferredLanguage\": \"EN\"\n}" }
          }
        },
        {
          "name": "Signup Seller",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signup", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","signup"] },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Ravi\",\n  \"lastName\": \"Kumar\",\n  \"mobileNumber\": \"9000000002\",\n  \"password\": \"Seller@123\",\n  \"appUsageRole\": \"SELLER\",\n  \"preferredLanguage\": \"HI\"\n}" }
          }
        },
        {
          "name": "Signin Admin (captures adminToken)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var res = pm.response.json();",
            "if (res.token) { pm.collectionVariables.set('adminToken', res.token); }",
            "pm.test('got admin token', function () { pm.expect(res.token).to.be.a('string'); });"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signin", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","signin"] },
            "body": { "mode": "raw", "raw": "{\n  \"mobileNumber\": \"9000000001\",\n  \"password\": \"Admin@123\"\n}" }
          }
        },
        {
          "name": "Signin Seller (captures sellerToken)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var res = pm.response.json();",
            "if (res.token) { pm.collectionVariables.set('sellerToken', res.token); }",
            "pm.test('got seller token', function () { pm.expect(res.token).to.be.a('string'); });"
          ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/signin", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","signin"] },
            "body": { "mode": "raw", "raw": "{\n  \"mobileNumber\": \"9000000002\",\n  \"password\": \"Seller@123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2. Masters",
