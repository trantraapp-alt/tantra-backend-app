  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "sellerToken", "value": "" },
    { "key": "moduleId", "value": "" },
    { "key": "cropCatId", "value": "" },
    { "key": "set_crop_name", "value": "" },
    { "key": "set_quality_grade", "value": "" },
    { "key": "set_harvest_year", "value": "" },
    { "key": "set_month", "value": "" },
    { "key": "set_unit", "value": "" },
