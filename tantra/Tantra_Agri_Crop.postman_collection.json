    {
      "name": "6. App - Listings (auth)",
      "item": [
        {
          "name": "Create Listing (captures listingId)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var res = pm.response.json();",
            "if (res.listingId) { pm.collectionVariables.set('listingId', res.listingId); }",
            "pm.test('created ok', function () { pm.expect(res.success).to.eql(true); pm.expect(res.listingId).to.be.a('string'); });"
          ] } } ],
          "request": {
            "method": "POST",
